# Copia este fichero a .env.local (en la raíz del monorepo). Lo leen la web, la API,
# el worker, los scripts de base de datos y los tests. Las variables definidas en la
# shell tienen prioridad sobre las de este fichero.

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL 14+; en producción, Neon). Rol propietario del esquema.
# En Neon puedes usar el endpoint con pooler (-pooler) también para la API y el worker:
# el aislamiento por empresa usa SET LOCAL dentro de transacciones, compatible con él.
DATABASE_URL=postgresql://localhost:5432/licitaciones_dev
# Base de datos desechable para las pruebas de integración (se vacía en cada ejecución).
TEST_DATABASE_URL=postgresql://localhost:5432/licitaciones_test

# ---------------------------------------------------------------------------
# Web (apps/web, puerto 3000). Origen público: enlaces en correos y callbacks de auth.
APP_URL=http://localhost:3000
# Dirección interna de la API a la que la web reenvía /api/* (nunca llega al navegador).
API_URL=http://localhost:3001
# true si la web está detrás de un balanceador que añade X-Forwarded-For.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# API (apps/api, Hono + Better Auth).
API_PORT=3001
# Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Opcional. Por defecto APP_URL. Solo el origen, sin ruta: el navegador llega a la API
# a través del proxy /api de la web, así que debe ser el origen de la web.
BETTER_AUTH_URL=
# Orígenes adicionales que pueden llamar a la API con cookies (separados por comas).
TRUSTED_ORIGINS=
# Opcional: inicio de sesión con Google. URI de redirección autorizada:
#   ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Correo transaccional (API y worker): resend | console (desarrollo) | disabled
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Licita <avisos@tu-dominio.es>"

# ---------------------------------------------------------------------------
# Worker (apps/worker). Fuente oficial PLACSP (sindicación 643).
PLACSP_FEED_URL=https://contrataciondelsectorpublico.gob.es/sindicacion/sindicacion_643/licitacionesPerfilesContratanteCompleto3.atom
IMPORT_MAX_PAGES=20
# Horarios en formato cron, en SCHEDULE_TIMEZONE.
SCHEDULE_TIMEZONE=Europe/Madrid
SCHEDULE_SYNC="*/30 * * * *"
SCHEDULE_DAILY="0 7 * * *"
SCHEDULE_WEEKLY="0 7 * * 1"
SCHEDULE_REMATCH="30 3 * * *"

# ---------------------------------------------------------------------------
# Almacenamiento de objetos S3 compatible (AWS S3, Cloudflare R2, MinIO…). Opcional:
# si S3_BUCKET está vacío no se archivan las páginas originales de cada importación.
S3_BUCKET=
S3_REGION=auto
# Para proveedores que no son AWS, p. ej. https://<cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para MinIO y la mayoría de servidores autoalojados.
S3_FORCE_PATH_STYLE=false
# Prefijo opcional de todas las claves, p. ej. production/
S3_PREFIX=
