{
  "name": "gestion-felina",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter @felina/api --filter @felina/web dev",
    "dev:worker": "vp run --filter @felina/worker dev",
    "build": "vp run -r build",
    "db:migrate": "vp run --filter @felina/db migrate",
    "db:seed": "vp run --filter @felina/db seed",
    "db:setup": "vp run --filter @felina/db migrate && vp run --filter @felina/db seed",
    "db:studio": "vp run --filter @felina/db studio",
    "admin:grant": "tsx packages/db/src/grant-admin.ts",
    "job": "tsx apps/worker/src/cli.ts",
    "test:e2e": "playwright test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@felina/api": "workspace:*",
    "@felina/api-client": "workspace:*",
    "@felina/core": "workspace:*",
    "@felina/db": "workspace:*",
    "@felina/domain": "workspace:*",
    "@felina/notifications": "workspace:*",
    "@felina/schemas": "workspace:*",
    "@felina/storage": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
