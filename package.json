{
  "name": "licitaciones-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter @licita/api --filter @licita/web dev",
    "dev:worker": "vp run --filter @licita/worker dev",
    "build": "vp run -r build",
    "db:migrate": "vp run --filter @licita/db migrate",
    "db:seed": "vp run --filter @licita/db seed",
    "db:setup": "vp run --filter @licita/db migrate && vp run --filter @licita/db seed",
    "db:studio": "vp run --filter @licita/db studio",
    "job": "tsx apps/worker/src/cli.ts",
    "test:e2e": "playwright test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@licita/api": "workspace:*",
    "@licita/api-client": "workspace:*",
    "@licita/core": "workspace:*",
    "@licita/db": "workspace:*",
    "@licita/domain": "workspace:*",
    "@licita/matching": "workspace:*",
    "@licita/notifications": "workspace:*",
    "@licita/procurement": "workspace:*",
    "@licita/schemas": "workspace:*",
    "@licita/storage": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
