# Copy to .env.local (gitignored). Expo loads it for Metro and for app.config.ts.

# Origin that serves /api (the web app, which proxies /api/* to apps/api, or the API
# itself). On the phone "localhost" is the phone itself:
#   * Android over USB or emulator: keep localhost and run `adb reverse tcp:3000 tcp:3000`.
#   * iPhone or Android over Wi-Fi: your Mac's LAN address, e.g. http://192.168.1.20:3000
#     (the web dev server must listen on the network, not only on localhost).
# EXPO_PUBLIC_* values are inlined by Metro: restart `vp run dev:mobile` after changing it.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps SDK for Android key (Google Cloud console). Only native Android builds
# need it (Expo Go and iOS don't); without it the maps show a notice instead.
# Baked into the native project: run `vp run --filter @felina/mobile android` again after changing it.
GOOGLE_MAPS_ANDROID_API_KEY=
